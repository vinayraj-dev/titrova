# Copy to .env (local) or set these in Cloudflare Pages → Settings → Environment variables.

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap.xml and robots.txt.
VITE_SITE_URL=https://titrova.pages.dev

# Shown on the Contact page. Leave empty to show GitHub Issues only.
VITE_CONTACT_EMAIL=

# Public source repository (used for "Report an issue" links).
VITE_REPO_URL=https://github.com/vinayraj-dev/titrova

# Name shown on the About page as the maintainer.
VITE_AUTHOR_NAME=Kappa Vinay

# --- Advertising (keep disabled until AdSense has approved the site) ---
VITE_ADS_ENABLED=false
VITE_ADSENSE_CLIENT=
VITE_AD_SLOT_HEADER=
VITE_AD_SLOT_SIDEBAR=
VITE_AD_SLOT_CONTENT=
VITE_AD_SLOT_FOOTER=

# --- Optional: Cloudflare Web Analytics (cookieless). Leave empty to load no analytics at all. ---
VITE_CF_ANALYTICS_TOKEN=
